rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function eligible() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('[^@]+@(gmail[.]com|naver[.]com)')
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/chatProfiles/$(uid);
    }

    function namePath(key) {
      return /databases/$(database)/documents/chatNames/$(key);
    }

    function validNickname(nickname) {
      return nickname is string
        && nickname.matches('[A-Za-z가-힣]+')
        && nickname.replace('[가-힣]', 'aa').size() <= 12;
    }

    function newNameOwnedBy(uid, key) {
      let name = namePath(key);
      return !exists(name) && getAfter(name).data.uid == uid;
    }

    function newProfileMatches(uid, key) {
      let profile = profilePath(uid);
      return !exists(profile) && getAfter(profile).data.nicknameKey == key;
    }

    match /chatProfiles/{uid} {
      allow get: if eligible() && request.auth.uid == uid;
      allow create: if eligible()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'nicknameKey'])
        && validNickname(request.resource.data.nickname)
        && request.resource.data.nicknameKey == request.resource.data.nickname.lower()
        && newNameOwnedBy(uid, request.resource.data.nicknameKey);
    }

    match /chatNames/{key} {
      allow create: if eligible()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && newProfileMatches(request.auth.uid, key);
    }

    function validPresence(uid) {
      let presence = request.resource.data;
      return eligible()
        && request.auth.uid == uid
        && presence.keys().hasOnly(['uid', 'nickname', 'seenAt', 'sessionId', 'tradeBuild'])
        && presence.uid == uid
        && presence.nickname == get(profilePath(uid)).data.nickname
        && presence.seenAt == request.time
        && presence.sessionId is string
        && presence.sessionId.matches('[0-9a-f]{32}')
        && (presence.get('tradeBuild', null) == null || supportedTradeBuild(presence.tradeBuild));
    }

    match /chatPresence/{uid} {
      allow get, delete: if eligible() && request.auth.uid == uid;
      allow list: if eligible() && request.query.limit <= 100
        && exists(profilePath(request.auth.uid));
      allow create, update: if validPresence(uid);
    }

    function supportedTradeBuild(build) {
      return build in [
        '940bb0ce65f3ed960aa2bd3dfc1411389aa0f64189849dc5b1a3b3ec2bc4e9a1',
        '6120e2ff614b9d5f743c66ba0e35d0f291b2f6b41666e4b9ae5278f53cab7aaa',
        '69c1a08516c4ae1812265915324dfbe51356dcb8e978f6e1fa8180085c3c832a',
        '48e4341338912b466c70e02322a5c8afbd406acb68a13031459b658fe976160d',
        'be8e982084bc78146e2da57eec0fe4dc89f1fd1caaf9735d9a76ec39c07539e9',
        '271566534a72d5c55a9d038c8165f6e2599c6a0e6f3ad402152f4145ea61c397',
        '31bb3b97a26fcd3288ac4185b1432e4c5091bff27cb02aa16d44a821051b3087',
        '68067f4a0828091e5093c53897bd609a0022e02fd538178f33d8842db2a16478',
        '305bda0d400ac8fa47cc19dee5f136394f4222bfb3fb045ac89f0ef8a253f32d',
        '21d0c07167f9945367531d24330e1e16c19a1b8b35111478a8badd9360627a62',
        'e6b974d48da610a11d7e3fec0bd5d064f13ee1cc633b62f87cdcad5a4e9fb336',
        '6e8ac761978f406a8fea5d737f498a17ff6a0c2ed685f7341806b20044ad197c',
        'be5509cb0fd3b72d73e017f53fab048048b8f15e9eac7397d00e122fc6ba6c42'
      ];
    }

    function readyToTrade(uid, build) {
      let presence = get(/databases/$(database)/documents/chatPresence/$(uid));
      return presence != null
        && presence.data.get('tradeBuild', null) == build
        && presence.data.seenAt + duration.value(100, 's') > request.time;
    }

    function tradeInvitePath(toUid) {
      return /databases/$(database)/documents/tradeInvites/$(toUid);
    }

    function tradeParty(invite) {
      return request.auth.uid == invite.fromUid || request.auth.uid == invite.toUid;
    }

    function tradeOpen(invite) {
      return invite.status != 'closed'
        && request.time < invite.createdAt + duration.value(invite.status == 'pending' ? 120 : 300, 's');
    }

    function validTradeInvite(toUid) {
      let invite = request.resource.data;
      return eligible()
        && invite.keys().hasOnly(['fromUid', 'toUid', 'nonce', 'romHash', 'createdAt', 'status'])
        && invite.toUid == toUid
        && invite.fromUid == request.auth.uid
        && toUid != invite.fromUid
        && invite.nonce is string
        && invite.nonce.matches('[0-9a-f]{32}')
        && supportedTradeBuild(invite.romHash)
        && invite.createdAt == request.time
        && invite.status == 'pending'
        && readyToTrade(invite.fromUid, invite.romHash)
        && readyToTrade(toUid, invite.romHash);
    }

    function tradeOfferSaved(invite) {
      let signal = getAfter(/databases/$(database)/documents/tradeSignals/$(invite.toUid));
      return signal != null && signal.data.nonce == invite.nonce
        && signal.data.inviteAt == invite.createdAt && signal.data.offeredAt == request.time
        && signal.data.answer == null;
    }

    function validTradeTransition() {
      let before = resource.data;
      let after = request.resource.data;
      return eligible()
        && tradeParty(before)
        && after.diff(before).affectedKeys().hasOnly(['status'])
        && (
          (after.status == 'closed' && before.status != 'closed')
          || (tradeOpen(before) && before.status == 'pending' && after.status == 'accepted'
            && request.auth.uid == before.toUid
            && readyToTrade(before.fromUid, before.romHash)
            && readyToTrade(before.toUid, before.romHash))
          || (tradeOpen(before) && before.status == 'accepted' && after.status == 'offered'
            && request.auth.uid == before.fromUid && tradeOfferSaved(before))
        );
    }

    match /tradeInvites/{toUid} {
      allow get: if eligible() && (request.auth.uid == toUid
        || (resource != null && request.auth.uid == resource.data.fromUid));
      allow create: if validTradeInvite(toUid);
      allow update: if (!tradeOpen(resource.data)
          && request.time >= resource.data.createdAt + duration.value(5, 's')
          && request.resource.data.nonce != resource.data.nonce
          && validTradeInvite(toUid))
        || validTradeTransition();
    }

    function validTradeSdp(sdp) {
      return sdp is string && sdp.size() >= 1 && sdp.size() <= 32000;
    }

    function validNewTradeOffer(toUid) {
      let before = get(tradeInvitePath(toUid)).data;
      let after = getAfter(tradeInvitePath(toUid)).data;
      let signal = request.resource.data;
      return eligible()
        && request.auth.uid == before.fromUid
        && tradeOpen(before)
        && before.status == 'accepted'
        && after.status == 'offered'
        && before.nonce == after.nonce
        && signal.keys().hasOnly(['nonce', 'inviteAt', 'offeredAt', 'offer', 'answer'])
        && signal.nonce == before.nonce
        && signal.inviteAt == before.createdAt
        && signal.offeredAt == request.time
        && validTradeSdp(signal.offer)
        && signal.answer == null;
    }

    function canReadTradeSignal(toUid) {
      let invite = get(tradeInvitePath(toUid)).data;
      return tradeParty(invite)
        && tradeOpen(invite)
        && invite.status == 'offered'
        && (resource == null || (resource.data.nonce == invite.nonce
          && resource.data.inviteAt == invite.createdAt));
    }

    function validTradeAnswer(toUid) {
      let invite = get(tradeInvitePath(toUid)).data;
      return request.auth.uid == toUid
        && tradeOpen(invite)
        && invite.status == 'offered'
        && resource.data.nonce == invite.nonce
        && resource.data.inviteAt == invite.createdAt
        && resource.data.answer == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
        && validTradeSdp(request.resource.data.answer);
    }

    function closesTrade(toUid) {
      let before = get(tradeInvitePath(toUid)).data;
      let after = getAfter(tradeInvitePath(toUid)).data;
      return tradeParty(before) && before.nonce == after.nonce
        && before.status != 'closed' && after.status == 'closed';
    }

    match /tradeSignals/{toUid} {
      allow get: if eligible() && canReadTradeSignal(toUid);
      allow create: if validNewTradeOffer(toUid);
      allow update: if validNewTradeOffer(toUid) || (eligible() && validTradeAnswer(toUid));
      allow delete: if eligible() && closesTrade(toUid);
    }

    function statePath() {
      return /databases/$(database)/documents/chatState/current;
    }

    function validSeq(seq) {
      return seq is int && seq >= 1 && seq <= 9007199254740991;
    }

    function slotId(seq) {
      return 'm' + string(seq % 100);
    }

    function advancesTo(seq) {
      let before = get(statePath());
      let after = getAfter(statePath());
      return seq == (before == null ? 1 : before.data.seq + 1)
        && after.data.seq == seq;
    }

    function rateMatches(messageId, seq) {
      let rate = getAfter(/databases/$(database)/documents/chatRate/$(request.auth.uid)).data;
      return rate.messageId == messageId && rate.seq == seq && rate.createdAt == request.time;
    }

    function messageMatches(uid, seq) {
      let id = slotId(seq);
      let message = getAfter(/databases/$(database)/documents/chatMessages/$(id)).data;
      return message.uid == uid && message.seq == seq && message.createdAt == request.time;
    }

    function validState(previousSeq) {
      let state = request.resource.data;
      return eligible()
        && state.keys().hasOnly(['seq'])
        && validSeq(state.seq)
        && state.seq == previousSeq + 1
        && messageMatches(request.auth.uid, state.seq);
    }

    match /chatState/current {
      allow get: if eligible();
      allow create: if validState(0);
      allow update: if validState(resource.data.seq);
    }

    function validRate(uid) {
      let rate = request.resource.data;
      return eligible()
        && request.auth.uid == uid
        && rate.keys().hasOnly(['messageId', 'createdAt', 'seq', 'previousAt', 'firstOfThreeAt'])
        && rate.keys().hasAll(['previousAt', 'firstOfThreeAt'])
        && validSeq(rate.seq)
        && rate.messageId == slotId(rate.seq)
        && rate.createdAt == request.time
        && advancesTo(rate.seq)
        && messageMatches(uid, rate.seq);
    }

    function cooldown() {
      let first = resource.data.get('firstOfThreeAt', null);
      let burst = first is timestamp
        && resource.data.createdAt <= first + duration.value(10, 's');
      return duration.value(burst ? 15 : 3, 's');
    }

    function validMessage(messageId) {
      let message = request.resource.data;
      return eligible()
        && message.keys().hasOnly(['uid', 'nickname', 'body', 'createdAt', 'seq'])
        && message.uid == request.auth.uid
        && message.nickname == get(profilePath(request.auth.uid)).data.nickname
        && message.body is string
        && message.body.size() >= 1
        && message.body.size() <= 240
        && message.createdAt == request.time
        && validSeq(message.seq)
        && messageId == slotId(message.seq)
        && advancesTo(message.seq)
        && rateMatches(messageId, message.seq);
    }

    match /chatMessages/{messageId} {
      allow list: if eligible() && request.query.limit <= 100;
      allow create: if validMessage(messageId);
      allow update: if validMessage(messageId)
        && request.resource.data.seq == resource.data.seq + 100;
    }

    match /chatRate/{uid} {
      allow get: if eligible() && request.auth.uid == uid;
      allow create: if validRate(uid)
        && request.resource.data.previousAt == null
        && request.resource.data.firstOfThreeAt == null;
      allow update: if validRate(uid)
        && request.resource.data.previousAt == resource.data.createdAt
        && request.resource.data.firstOfThreeAt == resource.data.get('previousAt', null)
        && request.time >= resource.data.createdAt + cooldown();
    }
  }
}
